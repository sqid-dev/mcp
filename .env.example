# Clerk instance that app.sqid.dev signs in with (clerk.sqid.dev). The MCP server is a
# resource server: Clerk issues the tokens, this server verifies them.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Machine secret of the Clerk Machine 'sqid-mcp' (Dashboard -> Configure -> Machines).
# The server mints short-lived M2M tokens with it to call app.sqid.dev as the verified
# person. The console admits this machine id via clerk.mcpMachineIds.
MCP_MACHINE_SECRET_KEY=ak_...
# Public URL of this server's MCP endpoint. Must match what is registered in Clerk
# (Dashboard -> Agents -> MCP servers) and what clients connect to: it is the token audience.
MCP_RESOURCE_URL=https://mcp.sqid.dev/mcp
# Where the Sqid console API lives (the tools forward the user's token here).
SQID_API=https://app.sqid.dev
SQID_PUBLIC_API=https://app.asksquid.ai/api/v1
PORT=8787
